# MADRSH — Apache config for SPA served from /madrseh/ subdirectory
# Place this file inside the /madrseh/ directory (next to index.html)

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /madrseh/

  # If the request is for an existing file, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Otherwise, route everything to index.html (SPA fallback)
  RewriteRule ^ index.html [L]
</IfModule>

# Ensure index.html is never cached (so new deploys take effect immediately)
<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
