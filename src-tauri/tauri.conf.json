{
  "$schema": "https://schema.tauri.app/config/1",
  "productName": "MADRSH",
  "version": "1.0.0",
  "identifier": "ir.madrseh.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "https://app.madrseh.ir",
    "beforeDevCommand": "",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "MADRSH",
        "width": 1200,
        "height": 800,
        "minWidth": 400,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
